{
  "name": "dsh-skill-mcp-manager",
  "description": "Manage DeepSeek Harness skills and MCP servers from inside a session",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "skill",
    "mcp",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-skill": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-commands": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.7-alpha.2"
  }
}
